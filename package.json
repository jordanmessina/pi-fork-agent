{
  "name": "pi-fork-agent",
  "version": "0.1.0",
  "description": "Cache-compatible conversation forks for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Jordan Messina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanmessina/pi-fork-agent.git"
  },
  "homepage": "https://github.com/jordanmessina/pi-fork-agent#readme",
  "bugs": {
    "url": "https://github.com/jordanmessina/pi-fork-agent/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "delegation",
    "prompt-cache"
  ],
  "files": [
    "index.ts",
    "runner.mjs",
    "scripts/poor-mans-eval.sh",
    "test/fixtures/*.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "pi --offline --no-extensions --extension ./index.ts --list-models __pi_fork_agent_no_match__",
    "check": "npm run typecheck && node --check runner.mjs && npm test && npm run smoke",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.1 <0.85.0",
    "typebox": ">=1.3.0 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "^24.10.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
